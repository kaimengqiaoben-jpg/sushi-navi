---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="サイト内検索" description="鮨道 SUSHIDO のサイト内検索です。">
  <article class="mx-auto max-w-2xl px-5 py-20 md:py-28">
    <p class="font-display italic text-gold text-sm tracking-widest mb-4">SEARCH</p>
    <h1 class="font-serif text-3xl md:text-4xl text-ink mb-10">サイト内検索</h1>

    <form id="search-form" role="search">
      <input
        type="search"
        id="search-input"
        name="q"
        placeholder="キーワードを入力（例: 柳刃、修行、給料）"
        class="w-full border border-line px-4 py-3 bg-paper text-ink text-base"
        autofocus
      />
    </form>

    <p id="search-status" class="text-ink-40 text-xs mt-4"></p>

    <div id="search-results" class="mt-6"></div>
  </article>
</BaseLayout>

<script is:inline>
  // is:inline: Viteのビルド処理を通さない生のスクリプトとして出力する。
  // 通常の<script>だとVite側の__VITE_PRELOAD__機構が動的importに割り込み、
  // ビルド後に生成されるpagefind.js（Vite管理外のファイル）の読み込みが壊れるため。
  (function () {
    const params = new URLSearchParams(location.search);
    const initialQuery = params.get('q') || '';

    const input = document.getElementById('search-input');
    const status = document.getElementById('search-status');
    const results = document.getElementById('search-results');
    input.value = initialQuery;

    let pagefind = null;
    let debounceTimer;

    async function loadPagefind() {
      if (pagefind) return pagefind;
      try {
        pagefind = await import('/pagefind/pagefind.js');
        await pagefind.init();
      } catch (e) {
        console.error('pagefind load error:', e);
        status.textContent = '検索機能は本番環境でのみ利用できます（ローカルのdevサーバーでは無効です）';
      }
      return pagefind;
    }

    async function runSearch(query) {
      if (!query.trim()) {
        results.innerHTML = '';
        status.textContent = '';
        return;
      }
      const pf = await loadPagefind();
      if (!pf) return;

      status.textContent = '検索中…';
      const search = await pf.search(query);
      const items = await Promise.all(search.results.slice(0, 20).map((r) => r.data()));

      if (items.length === 0) {
        status.textContent = '該当する記事が見つかりませんでした';
        results.innerHTML = '';
        return;
      }

      status.textContent = `${search.results.length}件見つかりました`;
      results.innerHTML = items
        .map(
          (item) => `
        <a href="${item.url}" class="group block border-b border-line py-6 first:pt-0">
          <h3 class="font-serif text-lg text-ink group-hover:text-accent transition-colors">${item.meta?.title || item.url}</h3>
          <p class="text-ink-70 text-sm mt-2 leading-relaxed">${item.excerpt}</p>
        </a>
      `
        )
        .join('');
    }

    input.addEventListener('input', () => {
      clearTimeout(debounceTimer);
      const q = input.value;
      debounceTimer = setTimeout(() => runSearch(q), 200);
      const url = new URL(location.href);
      if (q) url.searchParams.set('q', q); else url.searchParams.delete('q');
      history.replaceState({}, '', url);
    });

    document.getElementById('search-form')?.addEventListener('submit', (e) => e.preventDefault());

    if (initialQuery) runSearch(initialQuery);
  })();
</script>
