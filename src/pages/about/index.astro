---
// TODO(カイムさん): src/data/authors.ts の TODO 項目（資格・failureStory・xUrl・avatarImage=顔写真）
// を埋めると、このページに自動で反映されます。2026-09-16: ニックネーム「kaimu」で顔出し出演する方針に変更。
// 本名・店名は引き続き出さない。
import BaseLayout from '../../layouts/BaseLayout.astro';
import { author } from '../../data/authors';

const facts = [
  author.experienceYears ? { label: '経験年数', value: `板場に立って${author.experienceYears}年` } : null,
  author.style ? { label: '業態', value: author.style } : null,
  author.region ? { label: '活動地域', value: author.region } : null,
  author.overseasExperience ? { label: '海外経験', value: author.overseasExperience } : null,
  author.qualifications.length ? { label: '資格', value: author.qualifications.join('・') } : null,
].filter(Boolean) as { label: string; value: string }[];
---

<BaseLayout title="運営者について" description={`鮨道 SUSHIDO の運営者情報です。現役の寿司職人「${author.name}」が個人で運営しています。`}>
  <article class="mx-auto max-w-2xl px-5 py-20 md:py-28">
    <p class="font-display italic text-gold text-sm tracking-widest mb-4">ABOUT</p>
    <h1 class="font-serif text-3xl md:text-4xl text-ink mb-10">運営者について</h1>

    <div class="flex items-center gap-4 mb-10">
      <div class="w-20 h-20 shrink-0 rounded-full bg-line flex items-center justify-center text-ink-40 text-xs overflow-hidden">
        {author.avatarImage ? <img src={author.avatarImage} alt={author.name} class="w-20 h-20 object-cover" /> : '顔写真'}
      </div>
      <div>
        <p class="font-serif text-xl text-ink">{author.name}</p>
        <p class="text-ink-40 text-xs">{author.jobTitle}｜{author.workshopName}</p>
      </div>
    </div>

    <div class="prose prose-sushido max-w-none prose-headings:font-serif prose-p:text-ink-70 prose-p:leading-loose prose-a:text-accent">
      <p>
        「鮨道（SUSHIDO）」は、現役の寿司職人「{author.name}」が個人で運営しているメディアです。屋号として「{author.workshopName}」を名乗っていますが、複数人の編集部があるわけではなく、板場に立つ一人の職人が実務の言葉で技術・道具・キャリア・海外・経営について記録しています。
      </p>

      {
        facts.length > 0 && (
          <table>
            <tbody>
              {facts.map((f) => (
                <tr>
                  <th class="text-left pr-4 whitespace-nowrap">{f.label}</th>
                  <td>{f.value}</td>
                </tr>
              ))}
            </tbody>
          </table>
        )
      }

      {author.failureStory && <p>{author.failureStory}</p>}

      <h2>「{author.name}」について</h2>
      <p>
        「{author.name}」は本名ではなく、発信用のニックネームです。本名・勤務先の店名は公開していません。顔・手元・道具の写真は、実在する現役の職人が書いていることの証として公開しています。
      </p>

      <h2>発信している場所</h2>
      <ul>
        <li>このサイト（鮨道 SUSHIDO）</li>
        {author.noteUrl && <li><a href={author.noteUrl} target="_blank" rel="noopener">note</a></li>}
        {author.xUrl && <li><a href={author.xUrl} target="_blank" rel="noopener">X（旧Twitter）</a></li>}
      </ul>

      <p>
        記事のレビュー基準については<a href="/editorial-policy/">編集方針</a>にまとめています。お問い合わせは<a href="/contact/">こちら</a>から受け付けています。
      </p>
    </div>
  </article>
</BaseLayout>
