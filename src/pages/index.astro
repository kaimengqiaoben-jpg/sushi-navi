---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { categoryList } from '../data/categories';

const title = '鮨道 SUSHIDO';
const description = '現役寿司職人が、板場から書く。技術・道具・キャリア・海外・経営を、実務の言葉で記録する専門メディア。';

const glossary = await getCollection('glossary');
glossary.sort((a, b) => a.data.term.localeCompare(b.data.term, 'ja'));
const glossaryPreview = glossary.slice(0, 12);
---

<BaseLayout title={title} description={description}>
  <!--
    TODO(カイムさん): ヒーロー画像を撮影して差し替えてください（手元・板場・包丁など）。
    SITE_DESIGN.md ⑩「写真について」参照。画像がないうちは文字だけの構成にしています。
  -->
  <section class="border-b border-line">
    <div class="mx-auto max-w-5xl px-5 py-24 md:py-36">
      <p class="font-display italic text-gold text-sm tracking-widest mb-6">SUSHIDO</p>
      <h1 class="font-serif text-4xl md:text-6xl leading-[1.3] text-ink max-w-3xl">
        板場からしか<br />書けないことを書く。
      </h1>
      <p class="mt-8 text-ink-70 max-w-xl leading-loose">
        {description}
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-5 py-20 md:py-28">
    <p class="text-ink-40 text-xs tracking-widest mb-10">CATEGORY</p>
    <div class="grid gap-px bg-line md:grid-cols-2">
      {
        categoryList.map((c) => (
          <a href={c.path} class="group bg-paper p-8 md:p-10 flex flex-col justify-between min-h-[200px] hover:bg-paper-alt transition-colors">
            <div>
              <p class="font-display text-xs tracking-widest text-ink-40 mb-2">{c.labelEn}</p>
              <h2 class="font-serif text-2xl text-ink">{c.label}</h2>
            </div>
            <p class="text-ink-70 text-sm mt-6 leading-relaxed">{c.tagline}</p>
            <span class="mt-4 text-xs text-accent opacity-0 group-hover:opacity-100 transition-opacity">読む →</span>
          </a>
        ))
      }
    </div>
  </section>

  {
    glossaryPreview.length > 0 && (
      <section class="border-t border-line">
        <div class="mx-auto max-w-5xl px-5 py-20 md:py-28">
          <div class="flex items-baseline justify-between mb-8">
            <p class="text-ink-40 text-xs tracking-widest">GLOSSARY</p>
            <a href="/glossary/" class="text-xs text-accent border-b border-accent">用語辞典をすべて見る →</a>
          </div>
          <p class="text-ink-70 text-sm leading-loose max-w-xl mb-8">
            寿司職人が現場で使う言葉を、1語ずつ解説しています。
          </p>
          <ul class="flex flex-wrap gap-2">
            {glossaryPreview.map((t) => (
              <li>
                <a href={`/glossary/${t.id}/`} class="text-sm border border-line px-3 py-1.5 hover:bg-paper-alt transition-colors">
                  {t.data.term}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="border-t border-line bg-paper-alt">
    <div class="mx-auto max-w-5xl px-5 py-20 md:py-28 grid md:grid-cols-[1fr_2fr] gap-10">
      <p class="text-ink-40 text-xs tracking-widest">ABOUT</p>
      <div>
        <p class="text-ink-70 leading-loose max-w-xl">
          現役の寿司職人が、板場での実務をそのまま言葉にしています。架空の「編集部」は存在しません。個人運営です。
        </p>
        <a href="/about/" class="inline-block mt-6 text-sm text-accent border-b border-accent">運営者について読む →</a>
      </div>
    </div>
  </section>
</BaseLayout>
