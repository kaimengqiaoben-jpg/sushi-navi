---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import type { CategorySlug } from '../../data/categories';
import { isVisible } from '../../lib/content';

export const getStaticPaths = (async ({ paginate }) => {
  const CATEGORY_SLUGS = ['technique', 'career', 'tools', 'overseas', 'management'] as const;
  const all = (
    await Promise.all(
      CATEGORY_SLUGS.map(async (slug) => {
        const entries = await getCollection(slug, isVisible);
        return entries.map((entry) => ({
          href: `/${slug}/${entry.id}/`,
          title: entry.data.title,
          description: entry.data.description,
          category: slug as CategorySlug,
          publishedAt: entry.data.publishedAt,
        }));
      })
    )
  ).flat();

  all.sort((a, b) => b.publishedAt.valueOf() - a.publishedAt.valueOf());

  return paginate(all, { pageSize: 20 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
---

<BaseLayout title="記事一覧" description="鮨道 SUSHIDO の全記事を新着順に一覧できるページです。">
  <section class="mx-auto max-w-3xl px-5 py-20">
    <p class="font-display italic text-gold text-sm tracking-widest mb-4">ARTICLES</p>
    <h1 class="font-serif text-3xl md:text-4xl text-ink mb-10">記事一覧</h1>

    {
      page.data.length === 0 ? (
        <p class="text-ink-40 text-sm">現在準備中です。</p>
      ) : (
        page.data.map((a) => (
          <ArticleCard href={a.href} title={a.title} description={a.description} category={a.category} publishedAt={a.publishedAt} />
        ))
      )
    }

    <nav class="flex justify-between mt-12 text-sm">
      {page.url.prev ? <a href={page.url.prev} class="text-accent">← 前へ</a> : <span />}
      {page.url.next ? <a href={page.url.next} class="text-accent">次へ →</a> : <span />}
    </nav>
  </section>
</BaseLayout>
