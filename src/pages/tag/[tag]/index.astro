---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import { isVisible } from '../../../lib/content';
import type { CategorySlug } from '../../../data/categories';

export async function getStaticPaths() {
  const CATEGORY_SLUGS = ['technique', 'career', 'tools', 'overseas', 'management'] as const;
  const all = (
    await Promise.all(
      CATEGORY_SLUGS.map(async (slug) => {
        const entries = await getCollection(slug, isVisible);
        return entries.map((entry) => ({ slug, entry }));
      })
    )
  ).flat();

  const byTag = new Map<string, typeof all>();
  for (const item of all) {
    for (const tag of item.entry.data.tags) {
      if (!byTag.has(tag)) byTag.set(tag, []);
      byTag.get(tag)!.push(item);
    }
  }

  return Array.from(byTag.entries()).map(([tag, items]) => ({
    params: { tag },
    props: { tag, items },
  }));
}

const { tag, items } = Astro.props as {
  tag: string;
  items: { slug: CategorySlug; entry: any }[];
};

items.sort((a, b) => b.entry.data.publishedAt.valueOf() - a.entry.data.publishedAt.valueOf());
---

<BaseLayout title={`「${tag}」の記事一覧`} description={`「${tag}」というタグが付いた記事の一覧です。`}>
  <section class="mx-auto max-w-3xl px-5 py-20">
    <p class="font-display italic text-gold text-sm tracking-widest mb-4">TAG</p>
    <h1 class="font-serif text-3xl md:text-4xl text-ink mb-10">{tag}</h1>

    {
      items.map(({ slug, entry }) => (
        <ArticleCard
          href={`/${slug}/${entry.id}/`}
          title={entry.data.title}
          description={entry.data.description}
          category={slug}
          publishedAt={entry.data.publishedAt}
        />
      ))
    }

    <p class="mt-12 text-sm">
      <a href="/articles/" class="text-accent border-b border-accent">記事一覧へ戻る →</a>
    </p>
  </section>
</BaseLayout>
